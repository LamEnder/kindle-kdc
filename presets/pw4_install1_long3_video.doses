# kdc preset for GRAY video (gmplay -g -K): Kindle PaperWhite 4.
# Dual pulses, kdc-pulse.sh install 1 3: short 1 frame + long 3 frames (4 at
# 18 C). Same calibration as pw4_install1_long3.doses, tuned for speed:
#  - long pulses wherever they gain 1.5x a short one (not only near the rails)
#  - looser stop tolerances (grays 0.2 level, black/white 0.3)
#  - no history routes (they cost ~30 ms per full-screen scan of CPU)
# Model estimate (step tables): 40 scans over all 12 gray transitions, worst
# 8 (pw4_install1.doses: 206, worst 40).
install 1 3

dark_steps  0.000 0.018 0.096 0.161 0.295 0.245 0.163
light_steps 0.228 0.350 0.377 0.350 0.298 0.050 0.000
dark_long_steps  0.000 0.056 0.444 0.794 0.978 0.991 0.937
light_long_steps 1.200 1.194 1.231 1.297 1.038 0.047 0.000

long_ratio 1.5
long_short_max 3
settle_tol 0.2
rail_tol 0.3

# Dose matrix (dose-counting fallback, short pulses).
#    K   D   L   W
K    0   3   6  10
D   20   0   3   9
L   22   4   0   8
W   30  11   5   0
