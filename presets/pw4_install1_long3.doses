# kdc calibration: Kindle PaperWhite 4 (ED060KC4 panel, fw 5.18.1.1.1)
# DUAL pulses with a SHORTER long pulse: kdc-pulse.sh # Transition test (kdc-demo -g -k transition): mean |trail-gap| 6.2 at 11.1
# scans/s without history corrections (long 6: 5.0 at 9.1/s; short only: 6.6),
# 6.5 with them (the K band, which pulses cannot fix, dominates; the other 9
# rows 5.6 -> 2.4). Black rects on gray stay a little light (+10..20).
install 1 3
#   short = 1 frame (DU4 slot), long = 3 frames at 25 C, 4 at 18 C (DU slot).
# Short steps from 2026-11-07; long ladders 2026-11-08 at 18 C.
install 1 3

# Short pulse steps (levels moved by one pulse at levels 0, .5, .. 3), joint
# fit to the six short ladders, rms 0.137 levels.
dark_steps  0.000 0.018 0.096 0.161 0.295 0.245 0.163
light_steps 0.228 0.350 0.377 0.350 0.298 0.050 0.000

# Long pulse steps, fit to the six long ladders (stage1 16 --long, stage2
# 11 5 16 --long; KDC_CAL_RK=-1.20 fit_long.py, smoothed), rms 0.084. One long pulse:
# W -> 2.1, two -> 1.1, K -> 1.2, two -> 2.5; D or L -> W in two.
dark_long_steps  0.000 0.056 0.444 0.794 0.978 0.991 0.937
light_long_steps 1.200 1.194 1.231 1.297 1.038 0.047 0.000

# History (route) corrections: started from pw4_install1.doses, refitted with
# route_fit.py on this preset (the long pulses change the routes). Non-K rows
# of the transition test: 5.6 (none) -> 5.0 (install-1 routes) -> 2.4.
route K D +0.00
route K L +0.00
route K W +0.00
route D K -0.02
route D L -0.10
route D W -0.22
route L K +0.64
route L D +0.23
route L W +0.14
route W K -0.01
route W D -0.07
route W L +0.04

# Dose matrix (dose-counting fallback, short pulses).
#    K   D   L   W
K    0   3   6  10
D   20   0   3   9
L   22   4   0   8
W   30  11   5   0
